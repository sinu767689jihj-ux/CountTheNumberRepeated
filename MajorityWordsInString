import java.util.HashMap;
public class MajorityWordsInString {
    void majorityCount(String[] str)
    {
        HashMap<String,Integer> map=new HashMap<>();
        for(int i=0;i<str.length;i++)
            {
                String key=str[i];
                if(map.containsKey(key)){
                    int count=map.get(key);
                    map.put(key,count+1);
            }else{
                map.put(key,1);
               }
            }
            System.out.println(map);
        }
        public static void main(String[] args)
        {
            String[] str={"Raja","Mahendra","Srinu","Raja","Mahendra","Raja"};
            MajorityWordsInString obj=new MajorityWordsInString();
            obj.majorityCount(str);
        }  
}
