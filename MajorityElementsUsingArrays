public class MajorityElementsUsingArrays {
    void majorityCount(int[] arr)
    {
        for(int i=0;i<arr.length-1;i++)
        {
            for(int j=i+1;j<arr.length;j++)
            {
                if(arr[i]>arr[j])
                {
                    int temp=arr[i];
                    arr[i]=arr[j];
                    arr[j]=temp;
                }
            }
        }
        int n=arr.length/2;
        int count=arr[n];
        System.out.println(count);
    }
    public static void main(String[] args)
    {
        int[] arr={1,1,1,1,2,2,3,1,3};
        MajorityElementsUsingArrays obj=new MajorityElementsUsingArrays();
        obj.majorityCount(arr);
    
    }
}
